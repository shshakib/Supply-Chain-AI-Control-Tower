# Local demo credentials matching compose.yaml; do not reuse them in a shared deployment.
DATABASE_URL=postgresql+psycopg://control_tower:control_tower@localhost:5433/control_tower
CONTROL_TOWER_BIND_HOST=127.0.0.1
CONTROL_TOWER_DOCUMENT_DIR=synthetic_documents
OPENAI_API_KEY=
CONTROL_TOWER_SUPERVISOR_MODEL=gpt-5.6-terra
CONTROL_TOWER_SPECIALIST_MODEL=gpt-5.6-luna
# Optional per-agent overrides; blank or omitted values inherit the specialist model.
CONTROL_TOWER_SHIPMENT_MODEL=gpt-5.6-luna
CONTROL_TOWER_INVENTORY_MODEL=gpt-5.6-luna
CONTROL_TOWER_SUPPLIER_RISK_MODEL=gpt-5.6-luna
CONTROL_TOWER_CONTRACTS_MODEL=gpt-5.6-terra
CONTROL_TOWER_EMBEDDING_MODEL=text-embedding-3-small
CONTROL_TOWER_EMBEDDING_DIMENSIONS=384
CONTROL_TOWER_RISK_MCP_ENABLED=true
CONTROL_TOWER_RISK_MCP_URL=http://127.0.0.1:8010/mcp
CONTROL_TOWER_RISK_MCP_CONNECT_TIMEOUT_SECONDS=2
CONTROL_TOWER_HOST=127.0.0.1
CONTROL_TOWER_PORT=8000

# Per-question limits shared by the supervisor and all specialist calls.
CONTROL_TOWER_TIMEOUT_SECONDS=180
CONTROL_TOWER_REQUEST_TIMEOUT_SECONDS=30
CONTROL_TOWER_MAX_MODEL_CALLS=24
CONTROL_TOWER_MAX_TOTAL_TOKENS=60000
CONTROL_TOWER_MAX_OUTPUT_TOKENS=3000
# Optional estimated LLM-dollar cutoff. 0 disables it, not the other limits.
# Set BOTH rates to conservative USD-per-million ceilings for ALL selected models.
# No vendor prices are assumed. Embedding/indexing and hosting costs are excluded.
CONTROL_TOWER_MAX_COST_USD=0
CONTROL_TOWER_INPUT_USD_PER_MILLION=0
CONTROL_TOWER_OUTPUT_USD_PER_MILLION=0

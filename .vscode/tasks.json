{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Supply Chain AI Control Tower: Run External Risk MCP",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "windows": {
        "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe"
      },
      "args": [
        "-m",
        "control_tower.integrations.risk_mcp_server",
        "--host",
        "127.0.0.1",
        "--port",
        "8010"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PYTHONUNBUFFERED": "1"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "Supply Chain AI Control Tower: Run Full Local Stack",
      "dependsOn": [
        "Supply Chain AI Control Tower: Run External Risk MCP",
        "Supply Chain AI Control Tower: Run Web (SQLite)"
      ],
      "dependsOrder": "parallel",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "Supply Chain AI Control Tower: Run Web (SQLite)",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "windows": {
        "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe"
      },
      "args": [
        "-m",
        "control_tower.web",
        "--database-url",
        "sqlite:///./control_tower.db",
        "--host",
        "127.0.0.1",
        "--port",
        "8000"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PYTHONUNBUFFERED": "1"
        }
      },
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "Supply Chain AI Control Tower: Seed SQLite Demo",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "windows": {
        "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe"
      },
      "args": [
        "-m",
        "control_tower.cli",
        "--database-url",
        "sqlite:///./control_tower.db",
        "seed"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "Supply Chain AI Control Tower: Run Offline Demo",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "windows": {
        "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe"
      },
      "args": [
        "-m",
        "control_tower.cli",
        "--database-url",
        "sqlite:///./control_tower.db",
        "demo",
        "--trace"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "Supply Chain AI Control Tower: Ask LLM (SQLite, API Key)",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "windows": {
        "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe"
      },
      "args": [
        "-m",
        "control_tower.cli",
        "--database-url",
        "sqlite:///./control_tower.db",
        "ask",
        "${input:operationsQuestion}",
        "--user",
        "${input:persona}",
        "--trace"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "Supply Chain AI Control Tower: Index Documents (SQLite, API Key)",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "windows": {
        "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe"
      },
      "args": [
        "-m",
        "control_tower.cli",
        "--database-url",
        "sqlite:///./control_tower.db",
        "index-documents"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "Supply Chain AI Control Tower: Run Evaluations (SQLite, API Key)",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "windows": {
        "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe"
      },
      "args": [
        "-m",
        "control_tower.cli",
        "--database-url",
        "sqlite:///./control_tower.db",
        "evaluate"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "Supply Chain AI Control Tower: Test",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "windows": {
        "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe"
      },
      "args": [
        "-m",
        "pytest"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "Supply Chain AI Control Tower: Lint",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "windows": {
        "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe"
      },
      "args": [
        "-m",
        "ruff",
        "check",
        "src",
        "tests"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "Supply Chain AI Control Tower: Check Formatting",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "windows": {
        "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe"
      },
      "args": [
        "-m",
        "ruff",
        "format",
        "--check",
        "src",
        "tests"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "Supply Chain AI Control Tower: Format Code",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "windows": {
        "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe"
      },
      "args": [
        "-m",
        "ruff",
        "format",
        "src",
        "tests"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "Supply Chain AI Control Tower: Verify",
      "dependsOn": [
        "Supply Chain AI Control Tower: Test",
        "Supply Chain AI Control Tower: Lint",
        "Supply Chain AI Control Tower: Check Formatting"
      ],
      "dependsOrder": "sequence",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Supply Chain AI Control Tower: Start PostgreSQL",
      "type": "process",
      "command": "docker",
      "args": [
        "compose",
        "up",
        "-d",
        "--wait",
        "db"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "Supply Chain AI Control Tower: Start Risk MCP (Docker)",
      "type": "process",
      "command": "docker",
      "args": [
        "compose",
        "up",
        "-d",
        "--wait",
        "risk-feed"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "Supply Chain AI Control Tower: Seed PostgreSQL",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "windows": {
        "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe"
      },
      "args": [
        "-m",
        "control_tower.cli",
        "seed"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "Supply Chain AI Control Tower: Prepare PostgreSQL Demo",
      "dependsOn": [
        "Supply Chain AI Control Tower: Start PostgreSQL",
        "Supply Chain AI Control Tower: Seed PostgreSQL"
      ],
      "dependsOrder": "sequence",
      "problemMatcher": []
    },
    {
      "label": "Supply Chain AI Control Tower: Run Web (PostgreSQL)",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "windows": {
        "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe"
      },
      "args": [
        "-m",
        "control_tower.web"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PYTHONUNBUFFERED": "1"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "Supply Chain AI Control Tower: Stop PostgreSQL",
      "type": "process",
      "command": "docker",
      "args": [
        "compose",
        "stop",
        "db"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "operationsQuestion",
      "type": "promptString",
      "description": "Question for the Supply Chain AI Control Tower supervisor",
      "default": "Which delayed shipments could stop production, and what contractual remedies apply?"
    },
    {
      "id": "persona",
      "type": "pickString",
      "description": "Synthetic user whose deterministic access scope should be used",
      "default": "noah.east@controltower.demo",
      "options": [
        "noah.east@controltower.demo",
        "mia.west@controltower.demo",
        "priya.procurement@controltower.demo",
        "leo.quality@controltower.demo",
        "sofia.viewer@controltower.demo",
        "ava.admin@controltower.demo"
      ]
    }
  ]
}

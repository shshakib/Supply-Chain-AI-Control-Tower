{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Supply Chain AI Control Tower: Debug External Risk MCP",
      "type": "debugpy",
      "request": "launch",
      "module": "control_tower.integrations.risk_mcp_server",
      "args": [
        "--host",
        "127.0.0.1",
        "--port",
        "8010"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Supply Chain AI Control Tower: Debug Web (SQLite)",
      "type": "debugpy",
      "request": "launch",
      "module": "control_tower.web",
      "args": [
        "--database-url",
        "sqlite:///./control_tower.db",
        "--host",
        "127.0.0.1",
        "--port",
        "8000"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Supply Chain AI Control Tower: Debug Offline Demo",
      "type": "debugpy",
      "request": "launch",
      "module": "control_tower.cli",
      "args": [
        "--database-url",
        "sqlite:///./control_tower.db",
        "demo",
        "--trace"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Supply Chain AI Control Tower: Debug LLM Question",
      "type": "debugpy",
      "request": "launch",
      "module": "control_tower.cli",
      "args": [
        "--database-url",
        "sqlite:///./control_tower.db",
        "ask",
        "${input:debugQuestion}",
        "--user",
        "${input:debugPersona}",
        "--trace"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ],
  "compounds": [
    {
      "name": "Supply Chain AI Control Tower: Debug Full Local Stack",
      "configurations": [
        "Supply Chain AI Control Tower: Debug External Risk MCP",
        "Supply Chain AI Control Tower: Debug Web (SQLite)"
      ],
      "stopAll": true
    }
  ],
  "inputs": [
    {
      "id": "debugQuestion",
      "type": "promptString",
      "description": "Question for the Supply Chain AI Control Tower supervisor",
      "default": "Which delayed shipments could stop production, and what contractual remedies apply?"
    },
    {
      "id": "debugPersona",
      "type": "pickString",
      "description": "Synthetic user whose deterministic access scope should be used",
      "default": "noah.east@controltower.demo",
      "options": [
        "noah.east@controltower.demo",
        "mia.west@controltower.demo",
        "priya.procurement@controltower.demo",
        "leo.quality@controltower.demo",
        "sofia.viewer@controltower.demo",
        "ava.admin@controltower.demo"
      ]
    }
  ]
}
